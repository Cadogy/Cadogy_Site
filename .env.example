# Core
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000   # production: https://cadogy.com
NEXTAUTH_SECRET=                     # openssl rand -base64 32
MONGODB_URI=

# Email (Resend). Without a key, emails are skipped and logged.
RESEND_API_KEY=
FROM_EMAIL="Cadogy <hello@cadogy.com>"
ADMIN_NOTIFY_EMAIL=hello@cadogy.com   # receives inquiries and support tickets

# Bot protection (Cloudflare Turnstile). Required in production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Contact form timing tokens (falls back to NEXTAUTH_SECRET)
FORM_SIGNING_SECRET=

# Payments (Stripe Checkout for invoices)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=               # endpoint: /api/webhooks/stripe, event: checkout.session.completed
CRON_SECRET=                         # 32+ random chars; Vercel Cron sends it to /api/cron/billing

# Content
NEXT_PUBLIC_WP_API_URL=https://wp.cadogy.com/wp-json/wp/v2

# SEO (optional)
GOOGLE_SITE_VERIFICATION=
