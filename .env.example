# ─────────────────────────────────────────────────────────────────────────────
#  Cadogy · environment variables
#
#  Copy to .env.local for development:   cp .env.example .env.local
#  In production, set these in Vercel → Project → Settings → Environment
#  Variables. Never commit real values; .env.local is git-ignored.
#
#  Generate secrets with:   openssl rand -base64 32
#  Values are validated at startup by src/env.ts.
# ─────────────────────────────────────────────────────────────────────────────


# ── Site ─────────────────────────────────────────────────────────────────────

# Required. Public URL of the site, no trailing slash.
# Production: https://www.cadogy.com
NEXT_PUBLIC_APP_URL=http://localhost:3000


# ── Database ─────────────────────────────────────────────────────────────────

# Required. MongoDB connection string. Include the database name before the
# query string, e.g. mongodb+srv://user:pass@cluster.mongodb.net/cadogy?...
MONGODB_URI=


# ── Authentication (Better Auth) ─────────────────────────────────────────────

# Required. 32+ characters. Signs sessions and tokens; changing it signs
# everyone out.
BETTER_AUTH_SECRET=

# Recommended. Defaults to NEXT_PUBLIC_APP_URL.
# Production: https://www.cadogy.com
BETTER_AUTH_URL=http://localhost:3000

# Recommended. The first account that verifies this email becomes the owner.
# Afterwards, roles are managed from /admin/users.
OWNER_EMAIL=


# ── Bot protection (Cloudflare Turnstile) ────────────────────────────────────

# Required in production: public forms fail closed without the secret.
# In development, the check is skipped when the secret is empty.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional. 32+ characters. Signs contact-form timing tokens.
# Falls back to BETTER_AUTH_SECRET.
FORM_SIGNING_SECRET=


# ── Email (Resend) ───────────────────────────────────────────────────────────

# Optional. Without a key, emails are skipped and logged to the console.
RESEND_API_KEY=

# Sender for every email. The domain must be verified in Resend.
FROM_EMAIL="Cadogy <hello@cadogy.com>"

# Receives new inquiries and support tickets.
ADMIN_NOTIFY_EMAIL=hello@cadogy.com


# ── Payments (Stripe) ────────────────────────────────────────────────────────

# Optional. Without these, invoices still work and online payment is hidden.
STRIPE_SECRET_KEY=

# Webhook endpoint: https://www.cadogy.com/api/webhooks/stripe
# Event: checkout.session.completed
STRIPE_WEBHOOK_SECRET=


# ── Billing run (Vercel Cron) ────────────────────────────────────────────────

# Required for recurring billing. 32+ characters. Vercel Cron sends it as a
# bearer token to /api/cron/billing; requests without it are rejected.
CRON_SECRET=


# ── Content ──────────────────────────────────────────────────────────────────

# Optional. Headless WordPress REST API for articles.
NEXT_PUBLIC_WP_API_URL=https://wp.cadogy.com/wp-json/wp/v2


# ── Search ───────────────────────────────────────────────────────────────────

# Optional. Google Search Console verification token.
GOOGLE_SITE_VERIFICATION=
