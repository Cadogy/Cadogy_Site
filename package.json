    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "geist": "^1.9.0",
    "lucide-react": "^1.66.0",
    "mongoose": "^9.11.4",
    "next": "^16.4.3",
    "next-auth": "^4.24.15",
    "next-turnstile": "^1.0.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "resend": "^6.37.0",
    "sanitize-html": "^2.18.1",
    "server-only": "^0.0.1",
